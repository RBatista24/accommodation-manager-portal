# Copy this file to .env (development) and adjust as needed.
# .env is ignored by Git. Never commit real credentials or iCal feed URLs.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (local-only credentials).
DATABASE_URL=postgresql://amp:amp@localhost:5433/amp_dev?schema=public
# Only used by `pnpm db:check-drift`.
SHADOW_DATABASE_URL=postgresql://amp:amp@localhost:5433/amp_shadow?schema=public

# Timezone used to decide what "today" means (check-ins today, occupancy, ...).
APP_TIMEZONE=Europe/Lisbon

# Where the web app runs (for CORS). Comma-separated for several origins.
CORS_ORIGIN=http://localhost:5173

# How the platform reads Booking.com reservations:
#   mock - realistic fictional demo data (no Booking account needed)
#   ical - the iCal export links from the Booking.com extranet (configured in the app)
BOOKING_INTEGRATION_MODE=mock

# The user that manual actions are attributed to in the audit log (created by the seed).
DEFAULT_USER_NAME=Owner
DEFAULT_USER_EMAIL=owner@example.com

# Public address of this API, used to build the calendar links that Booking.com
# imports (Integrations -> Calendar export). Must be reachable from the internet,
# e.g. through a Cloudflare Tunnel that only exposes /api/calendar-export/.
# Leave unset for local testing (defaults to http://localhost:PORT).
# PUBLIC_BASE_URL=https://calendars.example.com
